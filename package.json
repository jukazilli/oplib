{
  "name": "oplib",
  "version": "0.1.0",
  "private": true,
  "description": "Acervo editorial interdisciplinar para artigos científicos e conteúdos autorais.",
  "engines": {
    "node": "22.12.0"
  },
  "packageManager": "pnpm@9.11.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check package.json components.json .prettierrc.json '*.{ts,mts,mjs}' 'src/**/*.{ts,tsx,css}' 'tests/**/*.{ts,tsx}'",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:areas": "node scripts/seed-knowledge-areas.mjs",
    "db:verify:areas": "node scripts/verify-knowledge-areas.mjs",
    "db:verify:taxonomy": "node scripts/verify-taxonomy.mjs",
    "db:verify": "node scripts/verify-database.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.4",
    "@clerk/ui": "^1.33.1",
    "@radix-ui/react-slot": "1.3.3",
    "@vercel/blob": "^2.8.0",
    "@vercel/functions": "^3.9.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.5",
    "jsdom": "30.1.0",
    "postcss": "8.5.28",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
