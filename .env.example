# URL pública do ambiente. Ex.: http://localhost:3000 ou URL de Preview.
NEXT_PUBLIC_SITE_URL=

# Clerk: a chave publicável pode chegar ao navegador; a chave secreta nunca.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
ADMIN_CLERK_USER_ID=

# Neon: pooling para runtime; conexão direta somente para migrations controladas.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Vercel Blob para capas. Na Vercel, prefira OIDC; token é apenas fallback local.
BLOB_COVERS_PREFIX=preview/covers
BLOB_READ_WRITE_TOKEN=

# Segredo aleatório próprio de cada ambiente para identificadores opacos.
VISITOR_ID_PEPPER=

# Somente workflows protegidos de backup usam estas variáveis.
BACKUP_BLOB_READ_WRITE_TOKEN=
BACKUP_ENCRYPTION_PUBLIC_KEY=
